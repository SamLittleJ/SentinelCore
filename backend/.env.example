APP_NAME=SentinelCore API
APP_ENV=development
APP_DEBUG=true

POSTGRES_USER=sentinelcore
POSTGRES_PASSWORD=sentinelcore
POSTGRES_DB=sentinelcore
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://sentinelcore:sentinelcore@localhost:5432/sentinelcore
TEST_DATABASE_URL=postgresql+psycopg://sentinelcore:sentinelcore@localhost:5432/sentinelcore_test

SECRET_KEY=change-this-in-real-environments
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_FAILURE_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15

# json for log collectors, text for reading in a terminal
LOG_LEVEL=INFO
LOG_FORMAT=text
# Leave empty to serve /metrics without authentication (local development)
METRICS_TOKEN=
