APP_NAME=SentinelCore API
APP_ENV=development
APP_DEBUG=true

POSTGRES_USER=sentinelcore
POSTGRES_PASSWORD=sentinelcore
POSTGRES_DB=sentinelcore
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://sentinelcore:sentinelcore@localhost:5432/sentinelcore
TEST_DATABASE_URL=postgresql+psycopg://sentinelcore:sentinelcore@localhost:5432/sentinelcore_test

# At least 32 bytes. Generate one with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-in-real-environments
ALGORITHM=HS256
JWT_ISSUER=sentinelcore
JWT_AUDIENCE=sentinelcore-api

# Expired or revoked sessions are deleted after this many days
SESSION_RETENTION_DAYS=30
# How often the API runs the cleanup; 0 disables it (use the CLI instead)
SESSION_CLEANUP_INTERVAL_MINUTES=60
ACCESS_TOKEN_EXPIRE_MINUTES=30

LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_FAILURE_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15

# json for log collectors, text for reading in a terminal
LOG_LEVEL=INFO
LOG_FORMAT=text
# Leave empty to serve /metrics without authentication (local development)
METRICS_TOKEN=
