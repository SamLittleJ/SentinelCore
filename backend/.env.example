APP_NAME=SentinelCore API
APP_ENV=development
APP_DEBUG=true

POSTGRES_USER=sentinelcore
POSTGRES_PASSWORD=sentinelcore
POSTGRES_DB=sentinelcore
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# The API signs in as its own role, which row-level security binds. The
# migrations create it; `python -m app.cli grant-api-login` then lets it sign
# in with this password. Development passwords are public, like the ones in
# docker-compose.yml; the role is shared by every database on the server.
DATABASE_URL=postgresql+psycopg://sentinelcore_app:sentinelcore_app@localhost:5432/sentinelcore
# The owner of the tables: migrations and grant-api-login only, never the API.
MIGRATIONS_DATABASE_URL=postgresql+psycopg://sentinelcore:sentinelcore@localhost:5432/sentinelcore
# The tests sign in as the owner, to build the schema, and act as the API's role.
TEST_DATABASE_URL=postgresql+psycopg://sentinelcore:sentinelcore@localhost:5432/sentinelcore_test

# At least 32 bytes. Generate one with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-in-real-environments
ALGORITHM=HS256
JWT_ISSUER=sentinelcore
JWT_AUDIENCE=sentinelcore-api
# Browser session cookies are Secure (HTTPS only). Browsers treat http://localhost
# as secure, so keep this true locally; set false only for plain-HTTP test hosts.
AUTH_COOKIE_SECURE=true

# How long an invitation link works (1-720 hours)
INVITATION_EXPIRE_HOURS=72

# Expired or revoked sessions are deleted after this many days
SESSION_RETENTION_DAYS=30
# How often the API runs the cleanup; 0 disables it (use the CLI instead)
SESSION_CLEANUP_INTERVAL_MINUTES=60
ACCESS_TOKEN_EXPIRE_MINUTES=30

LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_FAILURE_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15
# Failed sign-ins per address, of any email: this many at once, then this many
# an hour. The burst must exceed DETECTION_SPRAY_MIN_ACCOUNTS and be at least
# LOGIN_MAX_FAILED_ATTEMPTS.
LOGIN_ADDRESS_BURST=20
LOGIN_ADDRESS_FAILURES_PER_HOUR=6

# Detection rules: password spray, dormant accounts, then unfamiliar
# network and device (sign-ins compared, and how many before judging)
DETECTION_SPRAY_MIN_ACCOUNTS=10
DETECTION_SPRAY_WINDOW_MINUTES=15
DETECTION_DORMANT_DAYS=90
DETECTION_UNFAMILIAR_LOOKBACK_DAYS=90
DETECTION_UNFAMILIAR_MIN_SIGN_INS=3
# API key volume spike: an hour of at least FACTOR times the key's usual
# busiest hour and MIN_EVENTS events; the usual hour comes from the last
# LOOKBACK_DAYS, once the key has MIN_DAYS days of traffic
DETECTION_VOLUME_FACTOR=3
DETECTION_VOLUME_MIN_EVENTS=100
DETECTION_VOLUME_LOOKBACK_DAYS=14
DETECTION_VOLUME_MIN_DAYS=7

# Ingestion rate limit, per API key: up to this many events at once (at least
# 500, the largest batch), then this many a minute. A batch over the limit is
# refused whole with 429 and Retry-After.
INGEST_BURST_EVENTS=5000
INGEST_EVENTS_PER_MINUTE=1000
# Days each key's hourly event counts are kept (at least
# DETECTION_VOLUME_LOOKBACK_DAYS); the session cleanup deletes older ones
API_KEY_USAGE_RETENTION_DAYS=30

# json for log collectors, text for reading in a terminal
LOG_LEVEL=INFO
LOG_FORMAT=text
# Leave empty to serve /metrics without authentication (local development)
METRICS_TOKEN=

# Strict-Transport-Security max-age in seconds (e.g. 31536000 for a year).
# 0 sends no header. Set it only once the host is served over HTTPS:
# browsers remember it and then refuse plain HTTP to the host.
HSTS_MAX_AGE=0

# Swagger UI (/docs), ReDoc (/redoc) and the schema (/openapi.json); off when
# unset. The pages run code from a public CDN and cookies do not separate
# ports, so open them at http://127.0.0.1:8000/docs, another host than the
# console's localhost. Keep them off outside development.
API_DOCS_ENABLED=true
